# Binance API credentials
# Get these from https://www.binance.com/en/my/settings/api-management
# 
# IMPORTANT: Only enable "Read Info" permission, NOT trading!

BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Trusted notary connection
# Default values are used if omitted.
NOTARY_HOST=127.0.0.1
NOTARY_PORT=7047
